# Copy to .env to bake server URLs into the build. Without these the build
# points at the hosted demo (https://tabcast.xyz). Either way both URLs stay
# editable under "Server settings" in the popup.

# Your own deployment. On Fly these are the server and client app URLs that
# `wasp deploy fly launch <name>` creates.
WXT_SERVER_URL=https://my-app-server.fly.dev
WXT_DASHBOARD_URL=https://my-app-client.fly.dev

# A local `wasp start` while developing.
# WXT_SERVER_URL=http://localhost:3001
# WXT_DASHBOARD_URL=http://localhost:3000
