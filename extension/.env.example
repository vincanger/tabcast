# Copy to .env to bake server URLs into the build. Without these the build
# falls back to `wasp start` defaults, and either way both URLs stay editable
# under "Server settings" in the popup.

# Your own deployment. On Fly these are the server and client app URLs that
# `wasp deploy fly launch <name>` creates.
WXT_SERVER_URL=http://localhost:3001
WXT_DASHBOARD_URL=http://localhost:3000

# The hosted demo, for a build that points at it out of the box.
# TODO (AGENT): fill in once the demo is deployed to Fly.
# WXT_SERVER_URL=https://
# WXT_DASHBOARD_URL=https://
