datasource db {
  provider = "postgresql"
  // Wasp requires that the url is set to the DATABASE_URL environment variable.
  url      = env("DATABASE_URL")
}

// Wasp requires the `prisma-client-js` generator to be present.
generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  // Secret that stands in for a session on the podcast feed, which is fetched
  // by podcast apps that cannot log in. Rotating it revokes every subscriber.
  feedToken String?   @unique
  // Secret that lets the iOS Shortcut save articles without a session.
  // Separate from feedToken so a leaked feed URL cannot write.
  saveToken String?   @unique
  articles  Article[]
  episodes  Episode[]
  schedule  GenerationSchedule?
}

// Automatic generation. A half hourly job runs every enabled schedule whose
// nextRunAt has passed, then advances it. That column is the whole state.
model GenerationSchedule {
  userId        Int       @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled       Boolean   @default(false)
  // 1 = daily, 7 = weekly. Slots are on the hour or half hour, in UTC.
  everyDays     Int       @default(1)
  hourUtc       Int       @default(7)
  minuteUtc     Int       @default(0)
  // Skip the slot unless the inbox has at least this many articles.
  minArticles   Int       @default(3)
  // Copied from the length slider when the schedule is saved.
  mode          String    @default("summary")
  targetMinutes Int       @default(5)
  nextRunAt     DateTime?
  lastCheckedAt DateTime?

  @@index([enabled, nextRunAt])
}

model Article {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  url         String
  title       String
  siteName    String?
  byline      String?
  excerpt     String?
  textContent String
  wordCount   Int
  savedAt     DateTime @default(now())
  // Reading order within the inbox and then the episode. Null until the
  // user reorders; unranked articles follow the ranked ones by savedAt.
  position    Int?
  // Set once the article has been included in an episode.
  episode     Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  episodeId   Int?
  // Where this article's segment starts in the episode audio. Set by the job.
  startSeconds Int?

  @@unique([userId, url])
  @@index([userId, episodeId])
}

model Episode {
  id              Int       @id @default(autoincrement())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  // pending | generating | ready | failed
  status          String    @default("pending")
  // summary | full. A full episode reads every article verbatim, and its
  // targetMinutes is the estimate made when it was started.
  mode            String    @default("summary")
  // While generating: reading | writing | recording. Null otherwise.
  phase           String?
  targetMinutes   Int
  title           String    @default("Untitled episode")
  script          String?
  audioKey        String?
  durationSeconds Int?
  // Size of the MP3, needed for the RSS enclosure.
  audioBytes      Int?
  error           String?
  // Anyone with the link can open a public episode at /listen/:id. Off by
  // default; the owner flips it from the episode page.
  isPublic        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  articles        Article[]

  @@index([userId, createdAt])
}
