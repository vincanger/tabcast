# Set to false if this is your own private instance. The server then refuses
# every signup, so only accounts created before the switch can log in.
SIGNUPS_OPEN=true

# Episodes each account may generate. 0 is unlimited, which is what you want
# on your own instance. The hosted demo runs with 3.
EPISODES_PER_USER=0

# Verification and password reset emails. Get a key with sending access from
# resend.com after verifying your domain (see EMAILER_PLAN.md). In development
# Wasp only logs emails unless SEND_EMAILS_IN_DEVELOPMENT=true, and you can
# skip verification altogether so a local signup logs straight in.
RESEND_API_KEY=
SKIP_EMAIL_VERIFICATION_IN_DEV=true

# OpenAI writes the script and narrates it.
OPENAI_API_KEY=
OPENAI_SCRIPT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Any S3 compatible bucket. These values match the local MinIO in
# docker-compose.yml, so `docker compose up -d` is enough to develop offline.
# For a real bucket, swap in your credentials and drop S3_ENDPOINT (AWS) or
# point it at your provider, e.g. https://fly.storage.tigris.dev.
S3_BUCKET=article-podcast
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
